APP_NAME=TeenyURL
APP_PORT=8080

POSTGRES_DB=teenyurl
POSTGRES_USER=teenyurl
POSTGRES_PASSWORD=teenyurl
POSTGRES_PORT=5432

REDIS_PORT=6379

TEENYURL_JPA_DDL_AUTO=update
TEENYURL_CACHE_REDIS_ENABLED=true
TEENYURL_REDIS_REDIRECT_KEY_PREFIX=url:
TEENYURL_REDIS_REDIRECT_TTL=PT1H
TEENYURL_ANALYTICS_IP_HASH_SALT=teenyurl-local-dev
TEENYURL_RATE_LIMIT_CREATE_ENABLED=true
TEENYURL_RATE_LIMIT_CREATE_LIMIT=10
TEENYURL_RATE_LIMIT_CREATE_WINDOW=PT1M
TEENYURL_RATE_LIMIT_REDIRECT_ENABLED=false
TEENYURL_RATE_LIMIT_REDIRECT_LIMIT=120
TEENYURL_RATE_LIMIT_REDIRECT_WINDOW=PT1M
TEENYURL_RATE_LIMIT_REDIS_ENABLED=true
TEENYURL_RATE_LIMIT_REDIS_KEY_PREFIX=rate_limit:
TEENYURL_REQUEST_LOGGING_ENABLED=true
TEENYURL_SHORT_CODE_NODE_ID=0
TEENYURL_SHORT_CODE_EPOCH_MILLIS=1735689600000
TEENYURL_CREATE_API_KEY=
TEENYURL_ALLOW_PRIVATE_REDIRECT_TARGETS=false
